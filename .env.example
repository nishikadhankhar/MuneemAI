# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL (system of record) ---
# e.g. from Neon or Supabase: postgresql://user:password@host/dbname?sslmode=require
# Leave empty to keep data in memory.
DATABASE_URL=

# --- Inbound webhook (optional) ---
# Any long random string. Senders sign the raw body: X-Muneem-Signature: sha256=<hex HMAC-SHA256>
WEBHOOK_SECRET=

# --- Web research (optional) ---
TAVILY_API_KEY=
TINYFISH_API_KEY=
# TAVILY_DAILY_LIMIT=200
# TINYFISH_DAILY_LIMIT=20
# WEB_CACHE_HOURS=24

# --- ArangoDB (cloud) ---
# Leave ARANGO_URL empty to run without ArangoDB (data is kept in memory / CSV).
ARANGO_URL=
ARANGO_DB=muneem
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_VERIFY_TLS=true
# Only for a local install where the user may create databases via _system.
ARANGO_CREATE_DB=false

# --- LLM (chat agent) ---
# Leave LLM_API_KEY empty to run the chat in rules-only mode (no LLM).
LLM_PROVIDER=gemini
LLM_API_KEY=
# tried in order; on a rate limit (429) the next model is used
LLM_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- Bill scanning (uses LLM_API_KEY, Gemini vision) ---
# BILL_SCAN_MODEL=          # empty = same models as LLM_MODEL
# BILL_SCAN_MAX_FILES=4
# BILL_SCAN_MAX_MB=8
# Demo/tests only: return a labelled test bill instead of reading the photo.
BILL_SCAN_FAKE=false

# --- Tuning (defaults shown) ---
REVIEW_PERIOD_DAYS=2
SERVICE_Z=1.65
DEAD_STOCK_DAYS=30
MIN_HISTORY_DAYS=14
